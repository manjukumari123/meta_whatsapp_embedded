            "url": {
              "raw": "{{base_url}}/meta/signup/callback",
              "host": ["{{base_url}}"],
              "path": ["meta", "signup", "callback"]
            },
            "description": "Mock Meta signup callback - failure scenario"
          },
          "response": []
        },
        {
          "name": "Verify Webhook",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/meta/webhook?hub.mode=subscribe&hub.verify_token=mock_verify_token&hub.challenge=challenge-abc-123",
              "host": ["{{base_url}}"],
              "path": ["meta", "webhook"],
              "query": [
                {
                  "key": "hub.mode",
                  "value": "subscribe"
                },
                {
                  "key": "hub.verify_token",
                  "value": "mock_verify_token"
                },
                {
                  "key": "hub.challenge",
                  "value": "challenge-abc-123"
                }
              ]
            },
            "description": "Mock Meta webhook verification"
