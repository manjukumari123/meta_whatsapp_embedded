            "description": "Start mock Meta Embedded Signup flow"
          },
          "response": []
        },
        {
          "name": "Signup Callback - Success",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fail\": false\n}"
            },
            "url": {
              "raw": "{{base_url}}/meta/signup/callback",
              "host": ["{{base_url}}"],
